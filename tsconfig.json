{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "paths": {
      "screens": ["./src/screens"],
      "screens/*": ["./src/screens/*"],
      "components": ["./src/components"],
      "components/*": ["./src/components/*"],
      "lib": ["./src/lib"],
      "lib/*": ["./src/lib/*"],
      "app": ["./src/app"],
      "app/*": ["./src/app/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "types/**/*.d.ts"],
  "exclude": ["**/node_modules", "**/Pods", "website"]
}
