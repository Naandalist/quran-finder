{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"paths": {
			"@components/*": [
				"./src/components/*"
			],
			"@layouts/*": [
				"./src/layouts/*"
			],
			"config": [
				"./src/config/index"
			],
			"config/*": [
				"./src/config/*"
			]
		}
	}
}